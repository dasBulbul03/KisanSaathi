# KisanSaathi configuration.
#
# Copy to `.env` and edit: `make env` does that for you and generates the two
# secrets below. `.env` is git-ignored; this template is committed, so it holds
# no real values.
#
# Everything here has a working default, so an empty `.env` still boots in
# development. Production refuses to start without JWT_SECRET_KEY, and
# `docker compose` refuses to start without POSTGRES_PASSWORD.
#
# To see the values currently in effect, including every secret in full:
#
#     make secrets          # writes SECRETS.local.md, git-ignored
#     python3 -c "import sys; sys.path.insert(0,'backend'); \\
#       from app.core.config import get_settings; \\
#       s=get_settings(); print(s.resolved_database_url())"
#
# Precedence: real environment variables beat this file. The API reads `.env`
# and `../.env`; the Docker stack is configured by `docker-compose.yml`, which
# passes these values into the containers. See docs/DEPLOYMENT.md.

# --- app --------------------------------------------------------------------
# Any of development, test, staging, production. Only `production` enforces the
# fail-fast checks in core/config.py.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Emit one JSON object per log line. Turn off for human-readable local logs.
LOG_JSON=true
# FastAPI's debug mode. Leave false in production: it returns tracebacks.
DEBUG=false

# --- database ---------------------------------------------------------------
# Leave DATABASE_URL empty and the API builds the URL from the POSTGRES_* parts
# below. Set it only to point at a managed instance, in which case it overrides
# the parts. A bare `postgres://` or `postgresql://` is rewritten to the psycopg
# driver automatically.
#
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#
# Outside Docker with ENVIRONMENT=development or test, a host of localhost or
# empty selects SQLite at SQLITE_PATH instead, which is what `make dev` uses.
DATABASE_URL=
POSTGRES_USER=kisan
# Generated by `make env`. Also note: changing it here does not change the
# password inside an existing database volume. See docs/DEPLOYMENT.md.
POSTGRES_PASSWORD=kisan
POSTGRES_DB=kisansaathi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Only used on the SQLite path, for local development.
SQLITE_PATH=./kisansaathi_dev.db
# Connection pool. Postgres only; SQLite ignores these.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# Log every statement. Very noisy, and it will echo query parameters.
DB_ECHO=false

# --- security ---------------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs every access and refresh token. Generate with
# `openssl rand -hex 32`. Rotating it signs everyone out: `make rotate-jwt`.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
# Minimum length for a password at registration. 8 is the floor the schemas
# enforce; raise it for a real deployment.
PASSWORD_MIN_LENGTH=8
# PBKDF2 rounds for password hashing. Higher is slower to brute-force and slower
# to log in. 390000 is the OWASP figure for PBKDF2-HMAC-SHA256.
PBKDF2_ITERATIONS=390000

# --- cors -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. The Docker stack
# serves the app and the API from one origin, so CORS is not consulted there;
# this matters for the dev server and for a split-origin deployment. Never use
# `*` with credentials enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# --- cache and rate limiting ------------------------------------------------
# Redis backs both. Unset means caching and rate limiting are both off, which is
# the default in development and must not be the default in production.
REDIS_URL=
CACHE_TTL_SECONDS=120
RATE_LIMIT_ENABLED=false
# Per client, per window. 240/minute is generous for a human and still stops a
# script.
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# --- ai ---------------------------------------------------------------------
# Empty NVIDIA_API_KEY is not an error: the assistant falls back to the
# deterministic rules engine, which is what keeps the app working with no
# outbound calls. Set AI_ASSISTANT_ENABLED=false to remove the feature.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_RETRIES=2
AI_ASSISTANT_ENABLED=true
# Low by design: the assistant explains prices and logistics, it does not
# negotiate. See docs/AI_BOUNDARY.md.
AI_TEMPERATURE=0.25
AI_MAX_TOKENS=900

# --- integrations -----------------------------------------------------------
# `demo` means the seeded synthetic dataset. Anything else needs a base URL and
# a key; the provider is selected in app/integrations/.
MARKET_DATA_PROVIDER=demo
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
LOGISTICS_PROVIDER=demo
LOGISTICS_BASE_URL=
LOGISTICS_API_KEY=
# `database` writes notifications to a table the app reads. Any other value
# needs NOTIFICATION_PROVIDER to point at a real sender.
NOTIFICATION_PROVIDER=database

# --- uploaded media ---------------------------------------------------------
# Must be writable by uid 10001, the unprivileged user in the backend image,
# and it is the only thing in the container that needs a volume.
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- demo mode --------------------------------------------------------------
# true seeds the eight demo accounts, 120 days of synthetic prices and a sample
# order, and shows the demo banner. A real deployment wants false, which loads
# only reference data: roles, commodities, markets, quality parameters.
DEMO_MODE=true
# `python -m app.db.seed --reset` drops every table first. Local only. `false`
# skips seeding at container start entirely.
SEED_ON_START=true

# --- api surface ------------------------------------------------------------
# false hides /api/docs and /api/redoc. Turn it off on a public deployment.
DOCS_ENABLED=true

# --- compose and frontend build --------------------------------------------
# Host port nginx is published on. The stack is one origin, so this only changes
# where you open the app.
FRONTEND_PORT=8080
# Baked into the bundle at image build time.
#
# NOTE: the client is hardcoded to the same origin (/api/v1), so this is read by
# nothing today. It exists for a split-origin deployment, which needs a code
# change as well.
VITE_API_BASE_URL=
# Dev-server proxy target only. Ignored in a production build, where nginx
# proxies /api to the backend container.
VITE_BACKEND_ORIGIN=
# Whether the sign-in screen lists the demo accounts. Unset means: on in a dev
# build, and in the Docker stack whatever DEMO_MODE is. Set false and the list
# is compiled out of the bundle entirely.
VITE_SHOW_DEMO_ACCOUNTS=
